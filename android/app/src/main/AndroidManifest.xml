<?xml version="1.0" encoding="utf-8"?>
<!--
  Manifiesto nativo de Android para la aplicación "App Shoper".
  Define los componentes principales, políticas de respaldo y permisos de red
  requeridos por el contenedor WebView de Capacitor para la plataforma Android.

  Identidad de aplicación objetivo: com.abp.appshoper (alineada con capacitor.config.ts).
  Autor: John Fredy Marciales Morales
  Fecha: 2026-11-12
  Fase SDD: Fase 8 — Release, Sincronización Nativa y Empaquetado
-->
<!--
  Elemento raíz del manifiesto: declara el espacio de nombres estándar de Android
  utilizado por los atributos del sistema en este archivo XML.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      Bloque de aplicación: agrupa la configuración global del proceso Android.
      - android:allowBackup="false": deshabilita respaldos automáticos para evitar
        la extracción no controlada de datos locales sensibles (p. ej., sesión JWT
        demostrativa y estados persistidos en almacenamiento del WebView).
      - android:icon / android:roundIcon: referencian los íconos adaptativos de la app.
      - android:label: nombre visible de la aplicación, resuelto desde recursos.
      - android:supportsRtl="true": habilita soporte para diseños de derecha a izquierda.
      - android:theme: aplica el tema visual base de la aplicación.
    -->
    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <!--
          Actividad principal (MainActivity): contenedor del WebView de Capacitor
          que carga la interfaz web compilada de App Shoper y actúa como punto de entrada.
          - android:configChanges: delega en la actividad los cambios de configuración
            para evitar reinicios del WebView ante rotaciones o cambios de idioma/teclado.
          - android:name: clase de actividad que extiende BridgeActivity de Capacitor.
          - android:label: título asociado a la actividad principal.
          - android:theme: tema sin barra de acción para mostrar el splash/lanzamiento.
          - android:launchMode="singleTask": garantiza una única instancia en la pila.
          - android:exported="true": permite que el lanzador del sistema inicie la actividad.
        -->
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <!--
              Filtro de intención principal: registra la actividad como pantalla inicial
              en el lanzador de Android para que el usuario pueda abrir App Shoper.
            -->
            <intent-filter>
                <!-- Acción estándar que identifica la actividad principal ejecutable. -->
                <action android:name="android.intent.action.MAIN" />
                <!-- Categoría que publica la actividad en el lanzador de aplicaciones. -->
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

    <!--
      Permiso de acceso a Internet: indispensable para que el WebView y la capa HTTP
      de la aplicación consuman las APIs remotas de autenticación y catálogo definidas
      en la configuración de entorno. No se declaran permisos adicionales (cámara,
      almacenamiento externo o medios) porque App Shoper no requiere dichas capacidades.
    -->
    <uses-permission android:name="android.permission.INTERNET" />

</manifest>

